NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
PILOT_CONTACT_EMAIL=
ECONERA_PREVIEW=0
ECONERA_HOSTED=0

# AI (Faza F) — vetëm në server, kurrë në git
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# /admin dhe regjistrimet (Faza E)
# Të paktën 10 karaktere. Pa të, /admin mbetet i mbyllur.
ADMIN_PASSWORD=
# Çelësi sekret i Supabase (vetëm server). Pa të, regjistrimet ruhen lokalisht te .data/leads.json.
SUPABASE_SECRET_KEY=

# Phase 2 (all optional; every feature degrades safely without them). Server only, never in git.
# Image generation for AI Renovation designs.
OPENAI_API_KEY=
# Default gpt-image-2.5-flare (gpt-image-1 was shut down by OpenAI on 23 Oct 2026).
OPENAI_IMAGE_MODEL=
# Fast model for ECONERA Voice understanding (default claude-haiku-5-5).
ANTHROPIC_VOICE_MODEL=
# Daily platform-wide caps per AI feature (defaults: room 300, design 60, voice 3000, prescreen 500).
AI_DAILY_LIMIT_ROOM=
AI_DAILY_LIMIT_DESIGN=
AI_DAILY_LIMIT_VOICE=
AI_DAILY_LIMIT_PRESCREEN=
# Monthly caps (defaults: room 3000, design 600, voice 30000, prescreen 5000). AI_DISABLED=1 switches all AI off.
AI_MONTHLY_LIMIT_ROOM=
AI_MONTHLY_LIMIT_DESIGN=
AI_MONTHLY_LIMIT_VOICE=
AI_MONTHLY_LIMIT_PRESCREEN=
AI_DISABLED=
# Shared rate limits across server instances (Upstash Redis, REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Error monitoring (Sentry project DSN). Without it, errors still go to Vercel's runtime logs.
SENTRY_DSN=
